+
+  group('MergingCollectionParticipant', () {
+    test('空 local 合并两个唯一值生成一条 add change', () {
+      final participant = _FakeCollectionParticipant(
+        key: const SettingsTransferKey('mergeItems'),
+        group: SettingsTransferGroup.prompts,
+        order: 0,
